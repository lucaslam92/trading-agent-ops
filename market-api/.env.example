# Adapter selection
# mock       — built-in random-walk simulation (default, no external deps)
# eastmoney  — real-time A-share data via Eastmoney HTTP API + Yahoo Finance globals
# tushare    — post-market daily data via Tushare pro API (requires token + ≥2000 pts)
ADAPTER=mock

# Scheduler tick interval in seconds
# mock:       2.2 s recommended
# eastmoney:  5.0 s recommended (avoid rate limiting)
# tushare:   60.0 s recommended (daily data, no need for fast polling)
TICK_INTERVAL=2.2

# Tushare API token — required only when ADAPTER=tushare
# Obtain at https://tushare.pro/user/token
TUSHARE_TOKEN=

# SQLite database path (relative to market-api/)
DB_PATH=market.db
